% A_compute_height.m
% Uppgift a: Beräkna och plotta den maximala höjden raketen når
clear all; close all; clc;
%% Lägg till sökväg till funktionerna
addpath('functions');
%% Startparametrar
v_yx = 21; % Initial hastighet (m/s)
teta = deg2rad(81); % Startvinkel (grader -> radianer)
h = 0.01; % Steglängd för Runge-Kutta
F = 1; % Kraft under brinntiden
t1 = 0; t2 = 0.08; % Brinntidens start och slut
tend = 4; % Total simuleringstid
%% Beräkna rörelsen med hög noggrannhet
[~, ~, z3, ~, ~, ~, ~] = Rocketman(t1, t2, tend, h, F, v_yx, 1);
%% Extrahera positioner
x_pos = z3(1,:);
y_pos = z3(2,:);
x_vel = z3(3,:);
y_vel = z3(4,:);
%% Hitta maximal höjd och dess index
[y_max, idx_max] = max(y_pos);
x_max = x_pos(idx_max);

% Display original maximum
disp(['Original maximum: x = ', num2str(x_max), ', y = ', num2str(y_max)]);

%% Perform interpolation with different step sizes
% Define the step sizes to test
step_sizes = [1, 10, 30];
colors = {'r', 'g', 'b'};  % Colors for plotting

figure;
plot(x_pos, y_pos, 'o');
hold on;
grid on;
xlabel('x');
ylabel('y');
title('Quadratic Interpolation around Maximum with Different Step Sizes');

legend_entries = {'Original data'};
y_interp_results = zeros(size(step_sizes));

% Loop through each step size
for i = 1:length(step_sizes)
    step = step_sizes(i);
    
    % Determine indices for interpolation based on step size
    if idx_max > step && idx_max < length(y_pos) - step
        % Normal case - can take points with the specified step in both directions
        idx_range = [idx_max-step, idx_max, idx_max+step];
    else
        % Handle boundary cases
        if idx_max <= step
            % Near the beginning
            idx_range = [1, 1+step, 1+2*step];
        else
            % Near the end
            idx_range = [length(y_pos)-2*step, length(y_pos)-step, length(y_pos)];
        end
    end
    
    % Get the three points for interpolation
    x1 = x_pos(idx_range(1));
    x2 = x_pos(idx_range(2));
    x3 = x_pos(idx_range(3));
    y1 = y_pos(idx_range(1));
    y2 = y_pos(idx_range(2));
    y3 = y_pos(idx_range(3));
    
    % Set up the system of equations
    A = [x1^2, x1, 1;
         x2^2, x2, 1;
         x3^2, x3, 1];
    b = [y1; y2; y3];
    
    % Solve for the coefficients [a; b; c]
    coeffs = A \ b;
    
    % Extract the coefficients
    a = coeffs(1);
    b = coeffs(2);
    c = coeffs(3);
    
    % Find maximum of parabola: x_interp_max = -b/(2*a)
    x_interp_max = -b/(2*a);
    
    % Calculate the interpolated maximum y value
    y_interp_max = a*x_interp_max^2 + b*x_interp_max + c;
    y_interp_results(i) = y_interp_max;
    
    % Display results
    disp(['Step size ', num2str(step), ' interpolation:']);
    disp(['  Points used: (', num2str(idx_range(1)), ',', num2str(idx_range(2)), ',', num2str(idx_range(3)), ')']);
    disp(['  Interpolated maximum: x = ', num2str(x_interp_max), ', y = ', num2str(y_interp_max)]);
    disp(['  Difference from original y_max: ', num2str(y_interp_max - y_max)]);
    
    % Plot the interpolation
    x_fine = linspace(min(x_pos(idx_range)), max(x_pos(idx_range)), 100);
    y_fine = a*x_fine.^2 + b*x_fine + c;
    plot(x_fine, y_fine, [colors{i}, '-'], 'LineWidth', 1.5);
    plot(x_interp_max, y_interp_max, [colors{i}, '*'], 'MarkerSize', 10);
    
    % Add to legend
    legend_entries{end+1} = ['Step ', num2str(step), ' fitted parabola'];
    legend_entries{end+1} = ['Step ', num2str(step), ' maximum'];
end

legend(legend_entries);

% Create a summary table
figure;
subplot(2,1,1);
bar([0, step_sizes], [y_max, y_interp_results]);
xlabel('Step Size (0 = Original)');
ylabel('Maximum Height');
title('Comparison of Maximum Heights by Interpolation Step Size');
grid on;
xticks([0, step_sizes]);
xticklabels({'Original', '1', '2', '3'});

subplot(2,1,2);
bar([0, step_sizes], [0, y_interp_results - y_max]);
xlabel('Step Size (0 = Original)');
ylabel('Difference from Original');
title('Height Difference from Original Maximum');
grid on;
xticks([0, step_sizes]);
xticklabels({'Original', '1', '2', '3'});